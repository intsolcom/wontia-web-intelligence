{
    "name": "Wontia Medical",
    "slug": "wontia-medical",
    "version": "1.1.0",
    "author": "Wontia",
    "description": "Plantilla de salud digital Wontia Medical: bienestar con TIA, agenda y citas, teleconsulta, expediente autorizado, tienda de bienestar, suscripciones y notificaciones. Todos los modulos viven como bricks dentro de esta plantilla (no en el core de WWI).",
    "tier": "free",
    "category": "health",
    "requires": { "wwi": ">=3.4.0", "php": ">=8.1" },
    "features": [
        "Hero 2.0 con composicion de dos columnas y tarjetas flotantes",
        "Imagen del hero configurable desde el configurador del brick",
        "Identidad Wontia Medical (blanco, verdes suaves, lila/violeta para TIA, grises neutros)",
        "Modulos como bricks confinados a la plantilla",
        "TIA consume la capa BRICK de IA",
        "Bilinguismo ES/EN y respeto a prefers-reduced-motion y prefers-color-scheme"
    ],
    "tokens": {
        "primary": "#2F9E6F",
        "primaryStrong": "#247F57",
        "primarySoft": "#E7F5EE",
        "tia": "#7C5CFF",
        "tiaSoft": "#EFEAFF",
        "ink": "#17212B",
        "muted": "#64748B",
        "surface": "#FFFFFF",
        "surfaceAlt": "#F6F9F7",
        "border": "#E3E8E5",
        "radius": "14px",
        "font": "Inter"
    },
    "config": [
        { "key": "_h_hero", "label": "Portada (hero)", "type": "heading" },
        { "key": "hero_badge", "label": "Badge de posicionamiento", "type": "text", "default": "Salud digital · impulsada por TIA" },
        { "key": "hero_title", "label": "Titulo principal", "type": "text", "default": "Tu salud, conectada de una forma mas inteligente." },
        { "key": "hero_subtitle", "label": "Descripcion", "type": "textarea", "default": "Encuentra profesionales, agenda tu consulta, accede a servicios de bienestar y recibe el apoyo de TIA, todo en un solo lugar." },
        { "key": "hero_cta_label", "label": "Boton principal", "type": "text", "default": "Comenzar ahora" },
        { "key": "hero_cta_url", "label": "Enlace del boton principal", "type": "text", "default": "/perfil" },
        { "key": "hero_cta2_label", "label": "Boton secundario", "type": "text", "default": "Conoce como funciona" },
        { "key": "hero_cta2_url", "label": "Enlace del boton secundario", "type": "text", "default": "/tia" },
        { "key": "hero_image", "label": "Imagen del hero (la subes aqui desde el configurador)", "type": "image", "default": "" },
        { "key": "hero_image_alt", "label": "Texto alternativo de la imagen", "type": "text", "default": "Acompanamiento de salud digital con TIA" },
        { "key": "_h_benefits", "label": "Beneficios", "type": "heading" },
        { "key": "benefit_1", "label": "Beneficio 1", "type": "text", "default": "Asistencia digital con TIA" },
        { "key": "benefit_2", "label": "Beneficio 2", "type": "text", "default": "Agenda sencilla" },
        { "key": "benefit_3", "label": "Beneficio 3", "type": "text", "default": "Profesionales verificados" },
        { "key": "benefit_4", "label": "Beneficio 4", "type": "text", "default": "Privacidad y seguridad" },
        { "key": "_h_cards", "label": "Tarjetas flotantes (enlaces reales)", "type": "heading" },
        { "key": "card_tia_title", "label": "Tarjeta TIA", "type": "text", "default": "TIA te acompana" },
        { "key": "card_tia_url", "label": "Enlace TIA", "type": "text", "default": "/tia" },
        { "key": "card_pro_title", "label": "Tarjeta profesional", "type": "text", "default": "Profesionales verificados" },
        { "key": "card_pro_url", "label": "Enlace profesional", "type": "text", "default": "/agenda" },
        { "key": "card_dir_title", "label": "Tarjeta especialidades", "type": "text", "default": "Especialidades" },
        { "key": "card_dir_url", "label": "Enlace especialidades", "type": "text", "default": "/agenda" },
        { "key": "card_appt_title", "label": "Tarjeta cita", "type": "text", "default": "Agenda tu consulta" },
        { "key": "card_appt_url", "label": "Enlace cita", "type": "text", "default": "/agenda" },
        { "key": "card_appt_note", "label": "Nota de la tarjeta cita (vista previa)", "type": "text", "default": "Vista previa · sin datos reales" },
        { "key": "_h_api", "label": "App Wontia Medical", "type": "heading" },
        { "key": "medical_api_url", "label": "URL base de la app (Node API)", "type": "url", "default": "https://medical.wontia.com/med" },
        { "key": "_h_modules", "label": "Modulos visibles", "type": "heading" },
        { "key": "module_tia", "label": "TIA", "type": "toggle", "default": true },
        { "key": "module_agenda", "label": "Agenda y citas", "type": "toggle", "default": true },
        { "key": "module_teleconsulta", "label": "Teleconsulta", "type": "toggle", "default": true },
        { "key": "module_expediente", "label": "Expediente", "type": "toggle", "default": true },
        { "key": "module_tienda", "label": "Tienda", "type": "toggle", "default": true },
        { "key": "module_suscripciones", "label": "Suscripciones", "type": "toggle", "default": true },
        { "key": "_h_footer", "label": "Footer / contacto", "type": "heading" },
        { "key": "footer_about", "label": "Texto del footer", "type": "textarea", "default": "Wontia Medical no diagnostica, no prescribe ni modifica tratamientos. Las decisiones clinicas corresponden a profesionales habilitados." },
        { "key": "contact_phone", "label": "Telefono", "type": "text", "default": "" },
        { "key": "contact_email", "label": "Correo", "type": "text", "default": "" },
        { "key": "contact_whatsapp", "label": "WhatsApp (URL)", "type": "text", "default": "" }
    ],
    "assets": {
        "css": "/assets/themes/wontia-medical/medical.css",
        "js": "/assets/themes/wontia-medical/medical-app.js"
    }
}
